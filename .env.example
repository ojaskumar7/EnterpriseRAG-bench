# Local development only. Copy to .env and adjust as needed.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5433
API_PORT=8000

EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_DTYPE=float32
EMBEDDING_BATCH_SIZE=32

DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000002

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512
RERANKER_CANDIDATE_K=50

GEMINI_API_KEY=replace-with-a-local-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=2

GROUNDING_MIN_CITATIONS=1
GROUNDING_MIN_DOCUMENTS=1
GROUNDING_MIN_CLAIM_OVERLAP=0.2

JWT_SECRET=replace-with-a-long-local-secret
JWT_ALGORITHM=HS256
LOG_LEVEL=INFO
JSON_LOGS=false
